# App
# Must match the port `next dev` actually serves on, or outbound email links
# (verify, reset-password, digest) point at a dead port.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# db
# Neon (pooler, TLS required):
DATABASE_URL=postgresql://<user>:<password>@<pooler-host>/<db>?sslmode=require
# Local Postgres, e.g. the `ump` container on 5432:
# DATABASE_URL=postgresql://ump:ump@localhost:5432/ump

# auth
BETTER_AUTH_SECRET=random-32char-secret-key
BETTER_AUTH_URL=http://localhost:3000 # base url of app
ADMIN_EMAIL=admin@example.com

#email
RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Auth providers
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Vercel Blob (user avatar uploads)
# BLOB_READ_WRITE_TOKEN=

# Cron
CRON_SECRET=

# Telegram
# TELEGRAM_BOT_TOKEN=
